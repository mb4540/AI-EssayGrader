# ============================================================================
# LLM Configuration (Netlify AI Gateway)
# ============================================================================
# In production, the Netlify AI Gateway automatically injects:
#   OPENAI_API_KEY, OPENAI_BASE_URL
#   GEMINI_API_KEY, GOOGLE_GEMINI_BASE_URL
#   ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL
#
# For local development with `netlify dev`, these are also auto-injected.
# For local development WITHOUT `netlify dev`, set your own keys below:
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Neon Database Configuration
# Get this from your Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Test Database Configuration (for integration tests)
# Get this from Neon dashboard → Development branch → Connection Details
TEST_DATABASE_URL=postgresql://user:password@host-dev.neon.tech/dbname?sslmode=require

# JWT Secret for Authentication
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Netlify Blobs (optional - for file storage)
ALLOW_BLOB_STORAGE=false

# Application URL
# For local development
APP_BASE_URL=http://localhost:8888
# For production, set this to your Netlify domain
# APP_BASE_URL=https://your-site.netlify.app

# ============================================================================
# Frontend Settings (stored in browser localStorage, not env vars)
# ============================================================================
# ai_provider: gemini | openai | anthropic (default: gemini)
# ai_model: model ID from the registry (e.g., gemini-2.5-pro, gpt-4o, claude-sonnet-4-5-20250929)
# See src/lib/model-registry.ts for the full model catalog (16 models across 3 providers)
